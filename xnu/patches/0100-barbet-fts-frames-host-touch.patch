+ * address + one dummy byte. Data blocks (system info, ...) are requested
+ * with FTS_CMD_SYSTEM LOAD_DATA and are ready once the 4-byte header at
+ * address 0 (0xA5, type, 16-bit counter) changes (ftsCore.c requestSyncFrame).
+ */
+#define FTS_CMD_FB_R     0xa7u
+#define FTS_CMD_SYS      0xa4u
+#define SYS_LOAD_DATA    0x06u
+#define LOAD_SYS_INFO    0x01u
