diff --git a/bsd/dev/sweet_touchcore.c b/bsd/dev/sweet_touchcore.c
new file mode 100644
index 0000000..b02b971
--- /dev/null
+++ b/bsd/dev/sweet_touchcore.c
@@ -0,0 +1,239 @@
+/*
+ * Host-side touch processing; see sweet_touchcore.h.
+ * Modeled on UniXNU NativeNovatekTouch/NvtTouchCore.c (Apache-2.0).
+ */
+#include "sweet_touchcore.h"
+
+#if defined(KERNEL)
+#include <sys/systm.h>		/* memset, memcpy */
+#else
+#include <string.h>
+#endif
+
+void
+stc_reset(struct stc_core *core)
+{
+	memset(core, 0, sizeof(*core));
+}
+
+static void
+sort_i16(int16_t *v, int n)
+{
+	for (int i = 1; i < n; ++i) {
+		int16_t x = v[i];
+		int j = i;
+		while (j > 0 && v[j - 1] > x) {
+			v[j] = v[j - 1];
+			--j;
+		}
+		v[j] = x;
+	}
+}
+
+/* Per-node median of the startup frames: the untouched panel. */
+static void
+form_reference(struct stc_core *core, int nodes)
+{
+	int16_t column[STC_STARTUP];
+	for (int n = 0; n < nodes; ++n) {
+		for (int s = 0; s < STC_STARTUP; ++s) {
+			column[s] = core->startup[s][n];
+		}
+		sort_i16(column, STC_STARTUP);
+		core->reference[n] = (int16_t)(((int)column[STC_STARTUP / 2 - 1] + (int)column[STC_STARTUP / 2]) / 2);
+	}
+	core->have_reference = 1;
+}
+
+struct peak { int index, value; };
+struct blob { long sum_w, sum_r, sum_c; int peak, area; };
+
+/* Node (row, col) -> output pixel, centre of the node, honouring orientation. */
+static void
+node_to_pixel(const struct stc_config *cfg, long r_x16, long c_x16, int *x, int *y)
+{
+	/* r_x16, c_x16: fractional node coordinates times 16 */
+	long along_rows = cfg->swap ? cfg->width : cfg->height;
+	long along_cols = cfg->swap ? cfg->height : cfg->width;
+	long pr = (r_x16 + 8) * along_rows / (16L * cfg->rows);
+	long pc = (c_x16 + 8) * along_cols / (16L * cfg->cols);
+	long px = cfg->swap ? pr : pc;
+	long py = cfg->swap ? pc : pr;
+	if (cfg->flip_x) {
+		px = cfg->width - 1 - px;
+	}
+	if (cfg->flip_y) {
+		py = cfg->height - 1 - py;
+	}
+	*x = px < 0 ? 0 : (px >= cfg->width ? cfg->width - 1 : (int)px);
+	*y = py < 0 ? 0 : (py >= cfg->height ? cfg->height - 1 : (int)py);
+}
+
+int
+stc_process(struct stc_core *core, const struct stc_config *cfg, const int16_t *frame,
+    struct stc_contact *out, int max)
+{
+	const int rows = cfg->rows, cols = cfg->cols, nodes = rows * cols;
+	if (nodes <= 0 || nodes > STC_MAX_NODES) {
+		return 0;
+	}
+	if (!core->have_reference) {
+		memcpy(core->startup[core->startup_count++], frame, (size_t)nodes * sizeof(int16_t));
+		if (core->startup_count == STC_STARTUP) {
+			form_reference(core, nodes);
+		}
+		return -1;
+	}
+
+	int *delta = core->delta, *label = core->label;
+	core->max_delta = 0;
+	core->max_index = -1;
+	for (int i = 0; i < nodes; ++i) {
+		delta[i] = (int)frame[i] - (int)core->reference[i];
+		label[i] = -1;
+		if (delta[i] > core->max_delta) {
+			core->max_delta = delta[i];
+			core->max_index = i;
+		}
+	}
+
+	/* Steepest ascent: each node above the noise floor flows to its local maximum. */
+	struct peak peaks[STC_MAX_PEAKS];
+	int npeaks = 0;
+	for (int i = 0; i < nodes; ++i) {
+		if (delta[i] < cfg->noise) {
+			continue;
+		}
+		int cur = i;
+		for (;;) {
+			int best = cur, bv = delta[cur], r = cur / cols, c = cur % cols;
+			for (int dr = -1; dr <= 1; ++dr) {
+				for (int dc = -1; dc <= 1; ++dc) {
+					int rr = r + dr, cc = c + dc;
+					if ((!dr && !dc) || rr < 0 || rr >= rows || cc < 0 || cc >= cols) {
+						continue;
+					}
+					int n = rr * cols + cc;
+					if (delta[n] > bv || (delta[n] == bv && n > best)) {
+						bv = delta[n];
+						best = n;
+					}
+				}
+			}
+			if (best == cur) {
+				break;
+			}
+			cur = best;
+		}
+		int found = -1;
+		for (int p = 0; p < npeaks; ++p) {
+			if (peaks[p].index == cur) {
+				found = p;
+				break;
+			}
+		}
+		if (found < 0) {
+			if (npeaks == STC_MAX_PEAKS) {
+				continue;
+			}
+			peaks[npeaks].index = cur;
+			peaks[npeaks].value = delta[cur];
+			found = npeaks++;
+		}
+		label[i] = found;
+	}
+
+	struct blob blobs[STC_MAX_PEAKS];
+	memset(blobs, 0, sizeof(blobs));
+	for (int p = 0; p < npeaks; ++p) {
+		blobs[p].peak = peaks[p].value;
+	}
+	for (int i = 0; i < nodes; ++i) {
+		if (label[i] < 0) {
+			continue;
+		}
+		struct blob *b = &blobs[label[i]];
+		long w = delta[i] - cfg->noise / 2;
+		if (w <= 0) {
+			continue;
+		}
+		b->sum_w += w;
+		b->sum_r += w * (i / cols) * 16;
+		b->sum_c += w * (i % cols) * 16;
+		b->area++;
+	}
+
+	struct stc_contact found[STC_MAX_PEAKS];
+	int nfound = 0;
+	for (int p = 0; p < npeaks; ++p) {
+		struct blob *b = &blobs[p];
+		if (!b->sum_w || b->area >= cfg->palm_nodes) {
+			continue;	/* empty, or palm-sized */
+		}
+		int x, y;
+		node_to_pixel(cfg, (b->sum_r + b->sum_w / 2) / b->sum_w, (b->sum_c + b->sum_w / 2) / b->sum_w, &x, &y);
+		found[nfound].slot = -1;
+		found[nfound].x = x;
+		found[nfound].y = y;
+		found[nfound].peak = b->peak;
+		found[nfound].area = b->area;
+		nfound++;
+	}
+
+	/* Keep tracked slots: nearest contact within the radius, above the up threshold. */
+	int used[STC_MAX_PEAKS] = {0};
+	long radius2 = (long)cfg->track_radius * cfg->track_radius;
+	for (int s = 0; s < STC_SLOTS; ++s) {
+		struct stc_slot *slot = &core->slots[s];
+		if (!slot->active) {
+			continue;
+		}
+		int best = -1;
+		long bd = 0;
+		for (int c = 0; c < nfound; ++c) {
+			if (used[c] || found[c].peak < cfg->up) {
+				continue;
+			}
+			long dx = found[c].x - slot->x, dy = found[c].y - slot->y, d = dx * dx + dy * dy;
+			if (d <= radius2 && (best < 0 || d < bd)) {
+				best = c;
+				bd = d;
+			}
+		}
+		if (best < 0) {
+			slot->active = 0;
+			continue;
+		}
+		used[best] = 1;
+		found[best].slot = s;
+		slot->x = found[best].x;
+		slot->y = found[best].y;
+		slot->age++;
+	}
+	/* New contacts need the down threshold. */
+	for (int c = 0; c < nfound; ++c) {
+		if (used[c] || found[c].peak < cfg->down) {
+			continue;
+		}
+		for (int s = 0; s < STC_SLOTS; ++s) {
+			if (core->slots[s].active) {
+				continue;
+			}
+			core->slots[s].active = 1;
+			core->slots[s].age = 1;
+			core->slots[s].x = found[c].x;
+			core->slots[s].y = found[c].y;
+			found[c].slot = s;
+			used[c] = 1;
+			break;
+		}
+	}
+	int count = 0;
+	for (int c = 0; c < nfound && count < max; ++c) {
+		if (found[c].slot < 0 || core->slots[found[c].slot].age < 2) {
+			continue;	/* report from the second frame of a slot on */
+		}
+		out[count++] = found[c];
+	}
+	return count;
+}
diff --git a/bsd/dev/sweet_touchcore.h b/bsd/dev/sweet_touchcore.h
new file mode 100644
index 0000000..e1d71af
--- /dev/null
+++ b/bsd/dev/sweet_touchcore.h
@@ -0,0 +1,59 @@
+/*
+ * Host-side touch processing for a capacitive node matrix (barbet's ST
+ * FTM5 mutual-sense strength frames): baseline, delta, blobs, centroids,
+ * tracking. Pure C: no allocation, no I/O; host-tested.
+ *
+ * Modeled on UniXNU's NvtTouchCore (Apache-2.0, github.com/UniXNU/
+ * NativeNovatekTouch): steepest-ascent labelling, palm rejection,
+ * greedy nearest tracking with down/up hysteresis. Generalized to a
+ * runtime grid and a uniform node pitch.
+ */
+#ifndef SWEET_TOUCHCORE_H
+#define SWEET_TOUCHCORE_H
+#include <stdint.h>
+
+#define STC_MAX_NODES   2048
+#define STC_STARTUP     16
+#define STC_SLOTS       10
+#define STC_MAX_PEAKS   16
+
+struct stc_config {
+	int rows, cols;		/* frame is rows x cols, row-major */
+	int width, height;	/* output pixel space (1080 x 2400) */
+	int swap;		/* 1: rows run along x instead of y */
+	int flip_x, flip_y;
+	int noise;		/* nodes below this delta are ignored */
+	int down, up;		/* peak needed to start / keep a contact */
+	int palm_nodes;		/* blobs this large are not reported */
+	int track_radius;	/* pixels a contact may move per frame */
+};
+
+struct stc_contact {
+	int slot, x, y, peak, area;
+};
+
+struct stc_slot {
+	int active, x, y, age;
+};
+
+struct stc_core {
+	int have_reference, startup_count;
+	int16_t startup[STC_STARTUP][STC_MAX_NODES];
+	int16_t reference[STC_MAX_NODES];
+	int delta[STC_MAX_NODES];
+	int label[STC_MAX_NODES];
+	struct stc_slot slots[STC_SLOTS];
+	/* last frame statistics, for bring-up logs */
+	int max_delta, max_index;
+};
+
+void stc_reset(struct stc_core *core);
+/*
+ * Process one frame. Returns the number of contacts written to out (only
+ * slots seen for two frames or more), or -1 while the baseline is still
+ * being collected. Contacts absent from the result are up.
+ */
+int stc_process(struct stc_core *core, const struct stc_config *cfg, const int16_t *frame,
+    struct stc_contact *out, int max);
+
+#endif
