+static struct stc_core fts_core;	/* ~70 KiB: never on a 16 KiB kernel stack */
+static int16_t fts_frame[STC_MAX_NODES];
+static uint8_t fts_fb_buf[STC_MAX_NODES * 2];
+
+static struct {
+	unsigned tx, rx;
+	uint16_t raw, stren, base;
+} fsys;
+
+static int
+fts_fb_read(uint16_t addr, uint8_t *out, unsigned n)
+{
+	uint8_t rx[256];
+	while (n) {
+		unsigned chunk = n > 200 ? 200 : n;
+		const uint8_t cmd[3] = {FTS_CMD_FB_R, (uint8_t)(addr >> 8), (uint8_t)addr};
+		int err = fts_xfer(cmd, sizeof(cmd), rx, 3u + 1u + chunk);
+		if (err) {
+			return err;
+		}
+		bcopy(rx + 4, out, chunk);
+		out += chunk;
+		addr = (uint16_t)(addr + chunk);
+		n -= chunk;
+	}
+	return 0;
+}
+
+static int
+fts_load_data(uint8_t type)
+{
+	uint8_t h[4];
+	if (fts_fb_read(0, h, sizeof(h))) {
+		return EIO;
+	}
+	unsigned count = h[2] | (h[3] << 8);
+	const uint8_t pre[7] = {FTS_CMD_HW_W, 0x20, 0x00, 0x00, 0x00, 0x00, 0x00};
+	const uint8_t req[3] = {FTS_CMD_SYS, SYS_LOAD_DATA, type};
+	if (fts_write(pre, sizeof(pre)) || fts_write(req, sizeof(req))) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < 100; ++i) {
+		fts_wait(5);
+		if (!fts_fb_read(0, h, sizeof(h)) && h[0] == 0xa5 && h[1] == type &&
+		    (unsigned)(h[2] | (h[3] << 8)) != count) {
+			return 0;
+		}
+	}
+	printf("SWEET FTS: load data %#x timed out (header %02x %02x %02x %02x)\n", type, h[0], h[1], h[2], h[3]);
+	return ETIMEDOUT;
+}
+
+static bool
+fts_sysinfo(void)
+{
+	uint8_t d[216];
+	if (fts_load_data(LOAD_SYS_INFO) || fts_fb_read(0, d, sizeof(d))) {
+		return false;
+	}
+	if (d[0] != 0xa5 || d[1] != LOAD_SYS_INFO) {
+		printf("SWEET FTS: bad system info header %02x %02x\n", d[0], d[1]);
+		return false;
+	}
+	/* ftsCore.c readSysInfo field order: scrTxLen 83, scrRxLen 84, msTch raw/filter/strength/baseline 135.. */
+	fsys.tx = d[83];
+	fsys.rx = d[84];
+	fsys.raw = (uint16_t)(d[135] | (d[136] << 8));
+	fsys.stren = (uint16_t)(d[139] | (d[140] << 8));
+	fsys.base = (uint16_t)(d[141] | (d[142] << 8));
+	printf("SWEET FTS: sysinfo fw=%02x%02x cfg=%02x%02x res=%ux%u tx=%u rx=%u raw=%#x stren=%#x base=%#x\n",
+	    d[17], d[16], d[21], d[20], d[79] | (d[80] << 8), d[81] | (d[82] << 8),
+	    fsys.tx, fsys.rx, fsys.raw, fsys.stren, fsys.base);
+	return fsys.tx && fsys.rx && fsys.tx * fsys.rx <= STC_MAX_NODES;
+}
+
+static int
+fts_read_frame(uint16_t addr)
+{
+	unsigned nodes = fsys.tx * fsys.rx;
+	int err = fts_fb_read(addr, fts_fb_buf, nodes * 2u);
+	for (unsigned i = 0; !err && i < nodes; ++i) {
+		fts_frame[i] = (int16_t)(fts_fb_buf[2 * i] | (fts_fb_buf[2 * i + 1] << 8));
+	}
+	return err;
+}
