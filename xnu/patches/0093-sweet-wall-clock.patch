+/*
+ * Wall clock for clock_initialize_calendar(): boot-arg sweettime=<unix secs>
+ * (stamped by the host when it builds the boot image, tools/boot-now.sh)
+ * plus time since boot. The PMIC RTC counts from an arbitrary epoch on these
+ * phones (Android keeps the offset in userspace), so it is not used.
+ */
+long
+SweetPlatformExpert::getGMTTimeOfDay(void)
+{
+	uint64_t base = 0;
+	if (!PE_parse_boot_argn("sweettime", &base, sizeof(base)) || base == 0) {
+		return 0;
+	}
+	clock_sec_t up;
+	clock_usec_t upus;
+	clock_get_system_microtime(&up, &upus);
+	return (long)(base + up);
+}
+
+void
+SweetPlatformExpert::setGMTTimeOfDay(long secs)
+{
+	(void)secs;	/* nothing to write it to */
+}
