diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index b99c2f4..6b8f673 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -25,6 +25,23 @@
  */
 #define SWEET_SMP_MAX_CPUS         8
 
+/*
+ * Board differences between the two SoC cousins this config runs on.
+ * Default: Pixel 5a ("barbet", SM7250). Build with SWEET_BOARD_REDMI for
+ * the Redmi Note 10 Pro ("sweet", SM7150).
+ *   SWEET_EARLY_FB_PA  ABL splash framebuffer (DT cont_splash_region),
+ *                      1080x2400 BGRA, stride 4320 on both boards
+ *   SWEET_USB_QUSB2    the HS PHY is a QUSB2 at 0x088e2000 (sweet only;
+ *                      barbet has a Synopsys femto PHY at 0x088e3000)
+ */
+#if defined(SWEET_BOARD_REDMI)
+#define SWEET_EARLY_FB_PA          0x9c000000
+#define SWEET_USB_QUSB2            1
+#else
+#define SWEET_EARLY_FB_PA          0xa0000000
+#define SWEET_USB_QUSB2            0
+#endif
+
 #define ARM_ARCH_TIMER
 #define __ARM_ARCH__              8
 #define __ARM_VMSA__              8
