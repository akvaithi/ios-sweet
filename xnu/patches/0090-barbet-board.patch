diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index b6c1a41..3c251aa 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -11,6 +11,7 @@
  * power domain and clocks are on (an access to a gated block would hang).
  */
 #if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <pexpert/arm64/board_config.h>
 #include <sys/param.h>
 #include <sys/systm.h>
 #include <kern/clock.h>
@@ -119,6 +120,11 @@ sweet_usb_probe(void)
 	if (enabled >= 2) {
 		sweet_usb_gadget_start(dwc);
 	}
+#if !SWEET_USB_QUSB2
+	/* barbet: no QUSB2 at QUSB2_PA (its femto PHY sits at 0x088e3000); reading an absent block stalls the bus */
+	printf("SWEET USB: board has no QUSB2 PHY; PHY not read\n");
+	return;
+#endif
 	if (cbcr[5] & CBCR_CLK_OFF) {
 		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
 		return;
diff --git a/osfmk/arm64/arm_vm_init.c b/osfmk/arm64/arm_vm_init.c
index 06bb568..fb71ee2 100644
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1843,7 +1843,7 @@ sweet_early_map_final(void)
 	tt_entry_t *l2 = (tt_entry_t *)phystokv(l1 & ARM_TTE_TABLE_MASK);
 	tt_entry_t *slot = &l2[(va & ARM_TT_L2_INDEX_MASK) >> ARM_TT_L2_SHIFT];
 	assert(*slot == ARM_TTE_EMPTY);
-	*slot = 0x9c000000ULL | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
+	*slot = (uint64_t)SWEET_EARLY_FB_PA | ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK |
 	    ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) |
 	    ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) |
 	    ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX;
diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index 023086f..90ce465 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -515,7 +515,7 @@ LEXT(start_first_cpu)
 
 #if defined(SWEET)
 	/* Stage 0: white 64x32 band, no stack or page tables needed. */
-	MOV64	x0, (0x9c000000 + 2368 * 4320)
+	MOV64	x0, (SWEET_EARLY_FB_PA + 2368 * 4320)
 	mov		w1, #-1
 	mov		x2, #32
 	mov		x4, #4320
@@ -686,7 +686,7 @@ Lkernelcache_base_found:
 	 * SWEET uses 16K pages and all bring-up RAM is below 4GB, so the first
 	 * V=P L2 page is bootstrap_pagetables + 2*PGBYTES.
 	 */
-	MOV64	x10, 0x9c000000
+	MOV64	x10, SWEET_EARLY_FB_PA
 	MOV64	x11, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
 	orr		x11, x11, x10
 	and		x12, x10, #(ARM_TT_L2_INDEX_MASK)
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 6928957..07b0987 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -6,12 +6,13 @@
  * retain this console until the normal framebuffer serial console is ready.
  */
 #include <arm64/sweet_early.h>
+#include <pexpert/arm64/board_config.h>
 
 #if defined(SWEET)
