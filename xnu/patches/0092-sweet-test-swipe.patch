+/*
+ * Boot-arg sweetswipe=N: every N seconds, one finger swipes up from the
+ * bottom edge to mid-screen (~300 ms) -- the iPhone X unlock / go-home
+ * gesture -- through the same path as the touch driver. For bring-up
+ * without a working digitizer (QEMU, or before the panel's touch IC is
+ * ported); harmless once on the home screen.
+ */
+void
+SweetHIDTouch::swipeThread(void *arg, wait_result_t)
+{
+	UInt32 secs = (UInt32)(uintptr_t)arg;
+	for (unsigned n = 1;; n++) {
+		IOSleep(secs * 1000);
+		if (!gSweetTouch) {
+			continue;
+		}
+		IOLog("SWEET HID: test swipe %u\n", n);
+		for (int step = 0; step <= 20; step++) {
+			gSweetTouch->touch(0, true, 540, 2396 - step * 60);
+			IOSleep(16);
+		}
+		gSweetTouch->touch(0, false, 540, 1196);
+	}
+}
