+#define KEYS_GPIO_RT     ((SWEET_VOLUP_PPID & 0xffu) << 8 | 0x10u) /* GPIO STATUS1 */
 #define KEYS_NO_APID     0xffffu
 
 static vm_offset_t keys_core, keys_obs, keys_cnfg;
@@ -113,7 +114,7 @@ keys_thread(void *arg, wait_result_t result)
 		for (int k = 0; k < 3; ++k) {
