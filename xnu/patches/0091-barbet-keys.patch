 				sweet_hid_key(k, state[k]);
 			}
@@ -152,7 +153,7 @@ sweet_keys_init(void)
 		return;
 	}
 	keys_pon_apid = keys_find_apid(0x008, count);
-	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	keys_gpio_apid = keys_find_apid(SWEET_VOLUP_PPID, count);
 	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
 	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
 	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
diff --git a/pexpert/pexpert/arm64/SWEET.h b/pexpert/pexpert/arm64/SWEET.h
index 6b8f673..07b7655 100644
--- a/pexpert/pexpert/arm64/SWEET.h
+++ b/pexpert/pexpert/arm64/SWEET.h
@@ -33,13 +33,19 @@
  *                      1080x2400 BGRA, stride 4320 on both boards
  *   SWEET_USB_QUSB2    the HS PHY is a QUSB2 at 0x088e2000 (sweet only;
  *                      barbet has a Synopsys femto PHY at 0x088e3000)
+ *   SWEET_VOLUP_PPID   SPMI peripheral (SID << 8 | periph) of the active-low
+ *                      volume-up PMIC GPIO: sweet PM6150L GPIO2, barbet
+ *                      PM8150L GPIO5 (DT gpio_keys/vol_up), both on SID 4.
+ *                      Power and volume-down are PON RT_STS at SID 0 on both.
  */
 #if defined(SWEET_BOARD_REDMI)
 #define SWEET_EARLY_FB_PA          0x9c000000
 #define SWEET_USB_QUSB2            1
+#define SWEET_VOLUP_PPID           0x4c1
 #else
 #define SWEET_EARLY_FB_PA          0xa0000000
 #define SWEET_USB_QUSB2            0
+#define SWEET_VOLUP_PPID           0x4c4
 #endif
 
 #define ARM_ARCH_TIMER
