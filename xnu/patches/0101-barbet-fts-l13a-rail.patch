+/* PM8150 (SID 0) PMIC5 LDO n at 0x4000 + 0x100 * (n - 1). */
+static void
+fts_ldo_log(const char *when, unsigned ldo)
+{
+	unsigned base = 0x4000u + 0x100u * (ldo - 1u);
+	uint8_t st = 0, lo = 0, hi = 0, mode = 0, en = 0;
+	bool ok = !sweet_spmi_read(0, base + 0x08, &st) && !sweet_spmi_read(0, base + 0x40, &lo) &&
+	    !sweet_spmi_read(0, base + 0x41, &hi) && !sweet_spmi_read(0, base + 0x45, &mode) &&
+	    !sweet_spmi_read(0, base + 0x46, &en);
+	printf("SWEET FTS: %s L%uA %s status=%#x vset=%u mV mode=%#x en=%#x\n", when, ldo,
+	    ok ? "ok" : "READ FAILED", st, (unsigned)lo | ((unsigned)hi << 8), mode, en);
+}
+
+/*
+ * The FTM5 node lists no supplies; Linux keeps PM8150 L13A (3.3 V) on with
+ * regulator-always-on, and ABL may leave it off: then SPI answers but the
+ * sensing front end never runs. Same story as ios-sailfish's RMI4 rails.
+ */
+static void
+fts_power(void)
+{
+	int rail = 1;
+	(void)PE_parse_boot_argn("sweetftsrail", &rail, sizeof(rail));
+	bool spmi = sweet_spmi_init() == 0;
+	if (spmi) {
+		fts_ldo_log("before", 13);
+		fts_ldo_log("before", 16);
+	}
+	if (!rail) {
+		printf("SWEET FTS: rail vote skipped (sweetftsrail=0)\n");
+		return;
+	}
+	int error = sweet_rpmh_vreg_enable("ldoa13", 3300);
+	printf("SWEET FTS: L13A 3300 mV RPMh vote %s (%d)\n", error ? "FAILED" : "done", error);
+	fts_wait(20);
+	if (spmi) {
+		fts_ldo_log("after", 13);
+	}
+}
